# Local mock mode: every backend and sign-in endpoint is tools/mock-server.mjs.
# Used by:  npm run dev:mock  (Vite loads this file only in --mode mock)
# Nothing here corresponds to a real deployment.
VITE_OIDC_ISSUER=http://localhost:4000
VITE_OIDC_CLIENT_ID=localmockclientid
VITE_OIDC_AUTHORIZE_URL=http://localhost:4000/oauth2/authorize
VITE_OIDC_TOKEN_URL=http://localhost:4000/oauth2/token
VITE_OIDC_JWKS_URL=http://localhost:4000/.well-known/jwks.json
VITE_OIDC_SCOPE=openid email profile kb-api/access
VITE_OIDC_LOGOUT_URL=http://localhost:4000/logout
VITE_OIDC_LOGOUT_MODE=cognito
VITE_API_URL=http://localhost:4000
VITE_CHAT_URL=http://localhost:4000/chat
