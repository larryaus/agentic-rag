# Local mock mode — points every AWS dependency at tools/mock-server.mjs.
# Used by:  npm run dev:mock  (Vite loads this file only in --mode mock)
# Nothing here corresponds to a real AWS resource.
VITE_USER_POOL_ID=us-east-1_localmock
VITE_USER_POOL_CLIENT_ID=localmockclientid
VITE_COGNITO_DOMAIN=http://localhost:4000
VITE_API_URL=http://localhost:4000
VITE_CHAT_URL=http://localhost:4000/chat
VITE_AWS_REGION=us-east-1

# Dev-only: the mock's JWKS endpoint. A deployed build must NOT set this —
# leaving it unset routes ID-token verification through CognitoJwtVerifier.
VITE_MOCK_JWKS_URI=http://localhost:4000/.well-known/jwks.json
