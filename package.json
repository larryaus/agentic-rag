{
  "name": "enterprise-kb-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "infra",
    "frontend"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run -w frontend build && npm run -w infra build && npx -w infra cdk synth && .venv/bin/python -m pytest -q evals/tests",
    "mock": "node tools/mock-server.mjs",
    "dev:mock": "node tools/mock-server.mjs & npm run -w frontend dev"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.1.0",
    "eslint": "9.32.0",
    "esbuild": "0.25.8",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  }
}
