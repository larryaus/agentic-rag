# Local deployment settings for docker compose. Copy to .env and set LLM_API_KEY;
# everything else has a working default.

# Any OpenAI-compatible endpoint. The default is OpenAI.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# A separate key or endpoint for embeddings, if different from the chat model's.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# The question check costs one extra model call per question; "off" skips it.
# GUARDRAIL_INPUT_CHECK=model

# Ollama instead of a hosted model (docker compose --profile ollama up; see README).
# Switching embedding models later needs a reindex (see README).
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen3:8b
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
# LLM_MAX_CONTEXT_CHARS=90000
